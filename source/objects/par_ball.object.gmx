  <events>
    <event eventtype="0" enumb="0">
      <action>
        <libid>1</libid>
        <id>603</id>
        <kind>7</kind>
        <userelative>0</userelative>
        <isquestion>0</isquestion>
        <useapplyto>-1</useapplyto>
        <exetype>2</exetype>
        <functionname></functionname>
        <codestring></codestring>
        <whoName>self</whoName>
        <relative>0</relative>
        <isnot>0</isnot>
        <arguments>
          <argument>
            <kind>1</kind>
            <string>///Var

angle = 0
angle_plus = 3
xscale = 1

hspeed_max = 10
hspeed_excel = 2
hspeed_friction = 0.1

vspeed_jump = 25
vspeed_up_max = -vspeed_jump*1.5
vspeed_down_max = 16

gravity = 1
gravity_direction = 270
gravity_inversion = 1

temp_gravity = gravity
temp_hfriction = hspeed_friction

trail_use = true
trail_length = 20
trail_width = 60
trail_color = c_purple
trail_sprite = -1
trail_alpha = 0.1
trail_init()
</string>
          </argument>
        </arguments>
      </action>
    </event>
    <event eventtype="1" enumb="0">
      <action>
        <libid>1</libid>
        <id>603</id>
        <kind>7</kind>
        <userelative>0</userelative>
        <isquestion>0</isquestion>
        <useapplyto>-1</useapplyto>
        <exetype>2</exetype>
        <functionname></functionname>
        <codestring></codestring>
        <whoName>self</whoName>
        <relative>0</relative>
        <isnot>0</isnot>
        <arguments>
          <argument>
            <kind>1</kind>
            <string>///Trail Free

trail_final()
</string>
          </argument>
        </arguments>
      </action>
    </event>
    <event eventtype="3" enumb="2">
      <action>
        <libid>1</libid>
        <id>603</id>
        <kind>7</kind>
        <userelative>0</userelative>
        <isquestion>0</isquestion>
        <useapplyto>-1</useapplyto>
        <exetype>2</exetype>
        <functionname></functionname>
        <codestring></codestring>
        <whoName>self</whoName>
        <relative>0</relative>
        <isnot>0</isnot>
        <arguments>
          <argument>
            <kind>1</kind>
            <string>///Trail Calculate

if(trail_use){
    trail_calculate(trail_length)
}
</string>
          </argument>
        </arguments>
      </action>
    </event>
    <event eventtype="3" enumb="0">
      <action>
        <libid>1</libid>
        <id>603</id>
        <kind>7</kind>
        <userelative>0</userelative>
        <isquestion>0</isquestion>
        <useapplyto>-1</useapplyto>
        <exetype>2</exetype>
        <functionname></functionname>
        <codestring></codestring>
        <whoName>self</whoName>
        <relative>0</relative>
        <isnot>0</isnot>
        <arguments>
          <argument>
            <kind>1</kind>
            <string>///Moving

var i;
for(i=0; i&lt;5; i++)
{
    if(device_mouse_check_button(i, mb_left))
    {
        scr_ball_hspeed_excel(device_mouse_x_to_gui(i)&gt;(view_wview[0]/2))
        scr_ball_gravity_use(true)
        break
    }
}
if(i==5 and hspeed!=0)
{
    hspeed = (hspeed-(sign(hspeed)*hspeed_friction)) * (abs(hspeed)&gt;hspeed_friction)
}

angle += angle_plus
vspeed = median(vspeed, vspeed_up_max*gravity_inversion, vspeed_down_max*gravity_inversion)
</string>
          </argument>
        </arguments>
      </action>
      <action>
        <libid>1</libid>
        <id>603</id>
        <kind>7</kind>
        <userelative>0</userelative>
        <isquestion>0</isquestion>
        <useapplyto>-1</useapplyto>
        <exetype>2</exetype>
        <functionname></functionname>
        <codestring></codestring>
        <whoName>self</whoName>
        <relative>0</relative>
        <isnot>0</isnot>
        <arguments>
          <argument>
            <kind>1</kind>
            <string>///Collision Block

var ins = instance_place(x+hspeed, y+vspeed, par_block);
if(ins!=noone)
{
    angle_plus *= -1
    switch(ins.object_index)
    {
        case obj_wall:
            hspeed = 0
            vspeed = -vspeed_jump*sign(vspeed)
            scr_ball_gravity_use(true)
            scr_particle_collision()
            break
            
        case obj_wood:
            if(vspeed*gravity_inversion&gt;0){with(ins){instance_destroy()}}
            hspeed = 0
            vspeed = -vspeed_jump*sign(vspeed)
            scr_ball_gravity_use(true)
            scr_particle_collision()
            break
            
        case obj_arrow:
            speed = hspeed_max*3
            if(direction!=ins.direction)
            {
                x = ins.x
                y = ins.y
                direction = ins.direction
            }
            scr_ball_gravity_use(false)
            break
            
        case obj_cloud:
        case obj_cloud_flower:
            if(ins.mask_index==-1)
            {
                if(vspeed*gravity_inversion&gt;0)
                {
                    vspeed = -vspeed_jump*gravity_inversion
                    ins.image_alpha = ins.collision_alpha
                    ins.mask_index = spr_noone
                }
                else{
                    vspeed = -vspeed_jump*gravity_inversion*1.5
                }
                scr_ball_gravity_use(true)
                scr_particle_collision()
            }
            break
            
        case obj_jelly:
            if(vspeed*gravity_inversion&gt;0)
                vspeed = -vspeed_jump*gravity_inversion*1.5;
            else
                vspeed = vspeed_jump*gravity_inversion;
            hspeed = 0
            scr_ball_gravity_use(true)
            scr_particle_collision()
            break
            
        case obj_bomb:
            scr_particle_die()
            instance_destroy()
            break
            
        case obj_trap:
            scr_particle_die()
            instance_destroy()
            break
    }
}
</string>
          </argument>
        </arguments>
      </action>
    </event>
    <event eventtype="8" enumb="0">
      <action>
        <libid>1</libid>
        <id>603</id>
        <kind>7</kind>
        <userelative>0</userelative>
        <isquestion>0</isquestion>
        <useapplyto>-1</useapplyto>
        <exetype>2</exetype>
        <functionname></functionname>
        <codestring></codestring>
        <whoName>self</whoName>
        <relative>0</relative>
        <isnot>0</isnot>
        <arguments>
          <argument>
            <kind>1</kind>
            <string>///Drawing

if(trail_use){
    draw_trail_ext(trail_width, trail_color, trail_sprite, true, trail_alpha)
}

draw_sprite_ext(sprite_index, image_index, x, y, xscale, image_yscale, angle, image_blend, image_alpha)
</string>
          </argument>
        </arguments>
      </action>
    </event>
  </events>
